 #include "securec.h"
 #include "ka_memory_pub.h"
 #include "ka_base_pub.h"
 #include "ka_base.h"
 
 
+static unsigned short g_ka_crc16_table[256];
+static DEFINE_MUTEX(g_ka_crc16_table_lock);
+static bool g_ka_crc16_table_ready;
+
 unsigned short const *ka_base_get_crc16_table(void)
 {
-    return crc16_table;
+    unsigned int i;
+
+    mutex_lock(&g_ka_crc16_table_lock);
+    if (!g_ka_crc16_table_ready) {
+        for (i = 0; i < ARRAY_SIZE(g_ka_crc16_table); i++) {
+            unsigned short crc = (unsigned short)i;
+            unsigned int bit;
+
+            for (bit = 0; bit < 8; bit++) {
+                crc = (crc >> 1) ^ ((crc & 1U) ? 0xA001U : 0U);
+            }
+            g_ka_crc16_table[i] = crc;
+        }
+        g_ka_crc16_table_ready = true;
+    }
+    mutex_unlock(&g_ka_crc16_table_lock);
+
+    return g_ka_crc16_table;
 }
 EXPORT_SYMBOL_GPL(ka_base_get_crc16_table);
 
