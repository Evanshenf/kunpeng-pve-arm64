 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+int hw_vdavinci_get_region_info_caps(struct hw_vdavinci *vdavinci,
+                                     struct vfio_region_info *info,
+                                     struct vfio_info_cap *caps)
+{
+    u64 i;
+    int ret;
+    unsigned int map_num = 0;
+    size_t sparse_size;
+    struct vdavinci_bar_map *map;
+    struct vdavinci_mapinfo *mmio_map_info;
+    struct vfio_region_info_cap_sparse_mmap *sparse;
+
+    if (vdavinci == NULL || info == NULL || caps == NULL) {
+        return -EINVAL;
+    }
+
+    ret = hw_vdavinci_device_get_bar_info(vdavinci, info);
+    if (ret != 0) {
+        return ret;
+    }
+
+    mmio_map_info = hw_vdavinci_get_bar_sparse(vdavinci, info->index);
+    if (mmio_map_info == NULL) {
+        return 0;
+    }
+
+    for (i = 0; i < mmio_map_info->num; i++) {
+        map = &mmio_map_info->map_info[i];
+        if (map->map_type == MAP_TYPE_BACKEND ||
+            map->map_type == MAP_TYPE_PASSTHROUGH) {
+            map_num++;
+        }
+    }
+
+    if (map_num == 0) {
+        return 0;
+    }
+
+    sparse = hw_vdavinci_device_get_sparse_info(mmio_map_info, map_num);
+    if (sparse == NULL) {
+        return -ENOMEM;
+    }
+
+    sparse_size = sizeof(*sparse) +
+                  sparse->nr_areas * sizeof(sparse->areas[0]);
+    ret = vfio_info_add_capability(caps, &sparse->header, sparse_size);
+    kfree(sparse);
+    if (ret != 0) {
+        return ret;
+    }
+
+    info->flags |= VFIO_REGION_INFO_FLAG_MMAP;
+    return 0;
+}
+#endif
