#!/bin/sh
set -eu

matched=0

if [ "$#" -eq 0 ] && [ -n "${ASCEND_VFIO_BDFS:-}" ]; then
    old_ifs=$IFS
    IFS=,
    # BDFs contain no shell metacharacters; split the validated environment list.
    set -- $ASCEND_VFIO_BDFS
    IFS=$old_ifs
fi

if [ "$#" -gt 0 ]; then
    devices=""
    for bdf in "$@"; do
        case "$bdf" in
            [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F].[0-7]) ;;
            *)
                printf 'Invalid PCI BDF: %s\n' "$bdf" >&2
                exit 1
                ;;
        esac
        devices="$devices /sys/bus/pci/devices/$bdf"
    done
else
    devices="/sys/bus/pci/devices/*"
fi

for device in $devices; do
    [ -r "$device/vendor" ] || continue
    [ -r "$device/device" ] || continue
    [ "$(cat "$device/vendor")" = "0x19e5" ] || continue
    [ "$(cat "$device/device")" = "0xd500" ] || continue
    [ -w "$device/reset_method" ] || continue

    # A bus reset removes and re-enumerates the 310P endpoint under VFIO.
    printf '\n' > "$device/reset_method"
    printf 'Disabled PCI reset methods for %s\n' "$(basename "$device")"
    matched=$((matched + 1))
done

if [ "$matched" -eq 0 ]; then
    echo "No requested Ascend 310P PCI functions with a writable reset_method were found"
fi
